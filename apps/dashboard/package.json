{
  "name": "@onxbot/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/server.ts",
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    },
    "./traces": {
      "development": "./src/traces.ts",
      "types": "./dist/server/traces.d.ts",
      "import": "./dist/server/traces.js"
    },
    "./client": "./dist/client/index.html"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -b tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@onxbot/model": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
