{
  "name": "onxbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env apps/bot/src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file=.env apps/bot/dist/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --exclude 'tests/*.integration.test.ts'",
    "test:integration": "vitest run tests/*.integration.test.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx --conditions=development --env-file=.env apps/bot/src/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "ws": "^8.18.3"
  }
}
