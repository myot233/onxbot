# Local development credentials; match compose.yaml.
DATABASE_URL=postgresql://onxbot:onxbot_dev@127.0.0.1:5432/onxbot
POSTGRES_USER=onxbot
POSTGRES_PASSWORD=onxbot_dev
POSTGRES_DB=onxbot
POSTGRES_PORT=5432

# OneBot v11 implementation (e.g. NapCat) must be running separately.
ONEBOT_SELF_ID=123456789
ONEBOT_ENDPOINT=ws://127.0.0.1:3001
ONEBOT_TOKEN=replace-with-onebot-access-token

# echo verifies the complete pipeline without calling a paid model.
CHAT_PROVIDER=echo
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHAT_SYSTEM_PROMPT=你是一个友善、简洁的中文对话助手。
CHAT_HISTORY_TURNS=10
CHAT_MAX_INPUT_CHARS=8000
CHAT_TIMEOUT_MS=30000

# Integration tests create and drop isolated schemas in this database.
# TEST_DATABASE_URL=postgresql://onxbot:onxbot_dev@127.0.0.1:5432/onxbot
