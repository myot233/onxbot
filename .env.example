# Local development credentials; match compose.yaml.
DATABASE_URL=postgresql://onxbot:onxbot_dev@127.0.0.1:5432/onxbot
POSTGRES_USER=onxbot
POSTGRES_PASSWORD=onxbot_dev
POSTGRES_DB=onxbot
POSTGRES_PORT=5432

# OneBot v11 implementation (e.g. NapCat) must be running separately.
ONEBOT_SELF_ID=123456789
ONEBOT_ENDPOINT=ws://127.0.0.1:3001
ONEBOT_TOKEN=replace-with-onebot-access-token

# echo verifies the complete pipeline without calling a paid model.
CHAT_PROVIDER=echo
# Comma-separated QQ groups where the bot can participate without commands.
CHAT_GROUP_IDS=
# Optional subset of CHAT_GROUP_IDS for scheduled group topics.
CHAT_TOPIC_GROUP_IDS=
CHAT_MEMORY_REVIEW_GROUP_IDS=
# Optional subset of CHAT_GROUP_IDS for native QQ agent tools.
CHAT_QQ_TOOL_GROUP_IDS=
# Opt-in decision sampling for these enabled groups only.
CHAT_FEEDBACK_GROUP_IDS=
CHAT_GROUP_SYSTEM_PROMPT=
CHAT_MEMORY_DIR=memory
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional for DeepSeek-compatible endpoints: low, high, or max.
# DEEPSEEK_REASONING_EFFORT=high
# Enable DeepSeek Search & Fetch tools for agent turns.
CHAT_WEB_RESEARCH=false
CHAT_SYSTEM_PROMPT='You MUST respond in friendly, concise conversational Chinese.'
CHAT_HISTORY_TURNS=10
CHAT_MAX_INPUT_CHARS=8000
CHAT_TIMEOUT_MS=30000

# Integration tests create and drop isolated schemas in this database.
# TEST_DATABASE_URL=postgresql://onxbot:onxbot_dev@127.0.0.1:5432/onxbot

# Optional dashboard. No authentication by default; keep the port local.
# OBSERVE_PORT=8787
# Set a password (24+ printable ASCII characters) to opt into Basic auth (onxbot).
# OBSERVE_PASSWORD=replace-with-a-long-dashboard-password
# OBSERVE_HOST=127.0.0.1
